---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main { width: 820px; }
			.grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5rem;
				list-style: none; margin: 0; padding: 0;
			}
			.card {
				border: 1px solid rgb(var(--gray-light));
				border-radius: 14px;
				overflow: hidden;
				background: #fff;
				transition: box-shadow 0.2s ease, transform 0.2s ease;
			}
			.card a { display: block; text-decoration: none; color: inherit; }
			.card:hover { box-shadow: var(--box-shadow); transform: translateY(-2px); }
			.thumb {
				width: 100%; height: 190px; display: block;
				object-fit: cover; border-bottom: 1px solid rgb(var(--gray-light));
			}
			.body { padding: 16px 18px 20px; }
			.title { margin: 0 0 6px; font-size: 1.15rem; line-height: 1.35; color: rgb(var(--black)); }
			.desc {
				margin: 0 0 10px; color: rgb(var(--gray-dark)); font-size: 0.92rem; line-height: 1.55;
				display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;
			}
			.date { margin: 0; color: rgb(var(--gray)); font-size: 0.85rem; }
			.card:hover .title { color: rgb(var(--accent)); }
			@media (max-width: 720px) {
				.grid { grid-template-columns: 1fr; gap: 1rem; }
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section>
				<ul class="grid">
					{
						posts.map((post) => (
							<li class="card">
								<a href={`/blog/${post.id}/`}>
									{post.data.heroImage && (
										<Image class="thumb" width={600} height={600} src={post.data.heroImage} alt="" />
									)}
									<div class="body">
										<h4 class="title">{post.data.title}</h4>
										{post.data.description && <p class="desc">{post.data.description}</p>}
										<p class="date">
											<FormattedDate date={post.data.pubDate} />
										</p>
									</div>
								</a>
							</li>
						))
					}
				</ul>
			</section>
		</main>
		<Footer />
	</body>
</html>
